{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/scanner",
      "destination": "/scanner.html"
    },
    {
      "source": "/scanner/",
      "destination": "/scanner.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/scanner.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw-reset.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/pulse-notify",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/pharmacy-digest",
      "schedule": "0 6 * * 1"
    }
  ]
}
